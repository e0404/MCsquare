#ifndef H_define_cmake_build
#define H_define_cmake_build

#cmakedefine01 USE_MKL_LIB 

#cmakedefine VAR_DATA_PRECISION @VAR_DATA_PRECISION@	// 1 =  float, 2 = double
#cmakedefine VAR_SCORING_PRECISION @VAR_SCORING_PRECISION@	// 1 =  float, 2 = double
#cmakedefine VAR_COMPUTE_PRECISION @VAR_COMPUTE_PRECISION@	// 1 =  float, 2 = double

#cmakedefine HAVE_STRTOK_R
#cmakedefine HAVE_STRTOK_S
#cmakedefine HAVE_MATH_H
#cmakedefine HAVE_MATHIMF_H
#cmakedefine HAVE_BASETSD_H
#cmakedefine HAVE_DECLSPEC_ALIGNED
#cmakedefine HAVE_ATTRIBUTE_ALIGNED
#cmakedefine HAVE_ASSUME_ALIGNED
#cmakedefine HAVE_BUILTIN_ASSUME_ALIGNED
#cmakedefine HAVE_SSIZE_T
#cmakedefine HAVE_DIRENT_H
#cmakedefine HAVE_DIRECT_H
#cmakedefine HAVE_MKDIR_ONE_ARG
#cmakedefine HAVE_MKDIR_TWO_ARGS
#cmakedefine HAVE__MKDIR_ONE_ARG
#cmakedefine HAVE__MKDIR_TWO_ARGS

#cmakedefine MCsquare_VERSION "@MCsquare_VERSION@"
#cmakedefine MCsquare_VERSION_MAJOR @MCsquare_VERSION_MAJOR@
#cmakedefine MCsquare_VERSION_MINOR @MCsquare_VERSION_MINOR@
#cmakedefine MCsquare_VERSION_PATCH @MCsquare_VERSION_PATCH@
#cmakedefine MCsquare_VERSION_TWEAK @MCsquare_VERSION_TWEAK@

#cmakedefine MCsquare_GIT_TAG @MCsquare_GIT_TAG@
#cmakedefine MCsquare_GIT_BRANCH @MCsquare_GIT_BRANCH@
#cmakedefine MCsquare_GIT_REV @MCsquare_GIT_REV@

#cmakedefine RMDIR_CMD "@RMDIR_CMD@"

#if defined(HAVE_MKDIR_TWO_ARGS)
  #define MKDIR_COMPAT(folder, perm) mkdir((folder), (perm))
#elif defined(HAVE__MKDIR_TWO_ARGS)
  #define MKDIR_COMPAT(folder, perm) _mkdir((folder), (perm))
#elif defined(HAVE_MKDIR_ONE_ARG)
  #define MKDIR_COMPAT(folder, perm) mkdir((folder))
#elif defined(HAVE__MKDIR_ONE_ARG)
  #define MKDIR_COMPAT(folder, perm) _mkdir((folder))
#else
  #error "No suitable mkdir function found!"
#endif

// Precision
#if VAR_DATA_PRECISION==1
  #define VAR_DATA float
#else
  #define VAR_DATA double
#endif

#if VAR_SCORING_PRECISION==1
  #define VAR_SCORING float
#else
  #define VAR_SCORING double
#endif

#if VAR_COMPUTE_PRECISION==1
  #define VAR_COMPUTE float
  #define VLENGTH 16
#else
  #define VAR_COMPUTE double
  #define VLENGTH 8
#endif

// Cross platform compatibility
#ifdef HAVE_MATHIMF_H
  #include <mathimf.h>
#elif defined(HAVE_MATH_H)
  #include <math.h>
#else
  #error "No math header found!"
#endif

#ifdef HAVE_BASETSD_H
  #include <BaseTsd.h>
  #ifndef HAVE_SSIZE_T
    typedef SSIZE_T ssize_t;
  #endif
#endif

#ifndef M_PI
  #define M_PI 3.14159265359
#endif

#ifndef HAVE_STRTOK_R
  #define strtok_r strtok_s
#endif

#ifdef HAVE_DECLSPEC_ALIGNED
  #define ALIGNED_(n) __declspec(align(n))
#elif defined(HAVE_ATTRIBUTE_ALIGNED)
  #define ALIGNED_(n) __attribute__((aligned(n)))
#else
  #define ALIGNED_(n)
#endif

#if !defined(HAVE_ASSUME_ALIGNED) && defined(HAVE_BUILTIN_ASSUME_ALIGNED)
  #define __assume_aligned __builtin_assume_aligned
#else
  #define __assume_aligned
#endif

#ifndef __INTEL_COMPILER
  #pragma GCC diagnostic ignored "-Wunused-value"
  #define __assume_aligned __builtin_assume_aligned
#endif

#endif
